# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase. Nunca use o prefixo NEXT_PUBLIC_ em segredos — apenas
# as duas primeiras variáveis abaixo são realmente públicas.

# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role do Supabase. NUNCA expor ao navegador, NUNCA usar
# NEXT_PUBLIC_ aqui. Usada apenas em Server Actions/Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Hash bcrypt da senha administrativa (nunca a senha em texto puro).
# Gere com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 12))"
# IMPORTANTE: hashes bcrypt contêm "$" (ex.: $2b$12$...), e o Next.js expande
# "$ALGO" como referência a outra variável de ambiente nos arquivos .env.
# Escape cada "$" como "\$" para o valor não ser corrompido, ex.:
# ADMIN_PASSWORD_HASH=\$2b\$12\$abcaefghijklmnopqrstuv...
ADMIN_PASSWORD_HASH=

# Segredo usado para HMAC de IPs (pseudonimização em security_events) e
# para assinar/validar tokens de sessão administrativa e de votação.
APP_SECRET_KEY=

# Reservado para a futura camada de auditoria (seção 44 do documento
# técnico) — não utilizado na implementação atual.
AUDIT_ENCRYPTION_KEY=
